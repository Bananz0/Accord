<?xml version="1.0" encoding="utf-8"?>
<!--
    Theme from the upstream Accord UI.

    Kept separate from themes.xml (which still defines Theme.Gramophone) so the two can coexist
    while screens are ported across one at a time. The interesting parts of the upstream look are
    the SF Pro type ramp and the accent colour rather than a large style hierarchy - upstream
    defines only a handful of styles and does the rest inline in its layouts.
-->
<resources>

    <style name="Base.Theme.Accord" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/surfaceColor</item>
        <item name="android:spotShadowAlpha">0.3</item>
        <item name="colorAccent">@color/accentColor</item>
        <!-- Applies SF Pro to every widget that does not override it. -->
        <item name="android:fontFamily">@font/sf_pro_regular</item>
        <item name="fontFamily">@font/sf_pro_regular</item>
    </style>

    <style name="Theme.Accord" parent="Base.Theme.Accord" />

    <style name="Widget.Accord.BottomNavigation.LabelText" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">@font/sf_pro_medium</item>
        <item name="fontFamily">@font/sf_pro_medium</item>
    </style>

    <style name="Widget.Accord.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:minHeight">@dimen/bottom_nav_height</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/cl_bottom_nav_label</item>
        <item name="itemPaddingBottom">@dimen/bottom_nav_item_padding_bottom</item>
        <item name="itemPaddingTop">@dimen/bottom_nav_item_padding_top</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemTextAppearanceActive">@style/Widget.Accord.BottomNavigation.LabelText</item>
        <item name="itemTextAppearanceInactive">@style/Widget.Accord.BottomNavigation.LabelText</item>
        <item name="itemTextColor">@color/cl_bottom_nav_label</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

</resources>
